OPENALEX_API_KEY=xxxxxxxxx

# Set in the repository-root .env for the active Codex chat, then restart the API.
# Intentionally unset by default so /push remains disabled.
# FASTAPI_DETOUR_ROLLOUT_JSONL=/home/ai/.codex/sessions/YYYY/MM/DD/rollout-....jsonl

# Set only when deploy.sh --mount uses a non-default host path.
# FASTAPI_DETOUR_APPENDWATCH_REPORT=/absolute/custom/mount/.aivm-control/appendwatch/appendwatch-tree.txt
